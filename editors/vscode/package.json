{
  "name": "babbage-language",
  "displayName": "Babbage: Notations for the Analytical Engine",
  "description": "Syntax highlighting, a language server and a run button for Charles Babbage's notations of calculations for the Analytical Engine (Science Museum, BAB/L), transcribed cell for cell: every operation done on the engine as the sheets of its date show it, and every cell of the sheet checked.",
  "version": "0.1.0",
  "publisher": "chrishayuk",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/chrishayuk/analytical-engine"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "babbage",
    "analytical engine",
    "lovelace",
    "history of computing",
    "language server"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "babbage",
        "aliases": [
          "Babbage notation (babbage)",
          "babbage",
          "bab"
        ],
        "extensions": [
          ".bab"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "babbage",
        "scopeName": "source.bab",
        "path": "./syntaxes/babbage.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "babbage",
        "path": "./snippets/babbage.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "babbage.run",
        "title": "Run This Page",
        "category": "Babbage",
        "icon": "$(play)"
      },
      {
        "command": "babbage.store",
        "title": "Run This Page, With the Whole Store After Each Operation",
        "category": "Babbage"
      },
      {
        "command": "babbage.cards",
        "title": "Show This Page as Cards",
        "category": "Babbage"
      },
      {
        "command": "babbage.verify",
        "title": "Verify Every Page of the Corpus",
        "category": "Babbage"
      },
      {
        "command": "babbage.restartServer",
        "title": "Restart Language Server",
        "category": "Babbage"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "babbage.run",
          "when": "resourceLangId == babbage"
        }
      ],
      "commandPalette": [
        {
          "command": "babbage.run",
          "when": "editorLangId == babbage"
        },
        {
          "command": "babbage.store",
          "when": "editorLangId == babbage"
        },
        {
          "command": "babbage.cards",
          "when": "editorLangId == babbage"
        },
        {
          "command": "babbage.restartServer",
          "when": "editorLangId == babbage"
        }
      ]
    },
    "keybindings": [
      {
        "command": "babbage.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == babbage"
      }
    ],
    "taskDefinitions": [
      {
        "type": "babbage"
      }
    ],
    "configuration": {
      "title": "Babbage notation (babbage)",
      "properties": {
        "babbage.path": {
          "type": "string",
          "default": "",
          "description": "Path to a babbage program to use as the language server (babbage lsp) and to run pages with. Leave empty to use the one built into the extension."
        },
        "babbage.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages exchanged with the language server."
        }
      }
    },
    "configurationDefaults": {
      "[babbage]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.wordBasedSuggestions": "off"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:vscode": "node test/vscode/run.mjs",
    "package": "node build.mjs && vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
